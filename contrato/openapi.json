    "/api/tarefas": {
      "get": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Lista tarefas paginadas, com filtros e ordenação",
        "operationId": "ListarTarefas",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "tamanho",
            "in": "query",
            "schema": {
              "maximum": 50,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          },
          {
            "name": "ordenarPor",
            "in": "query",
            "schema": {
              "default": "Prazo",
              "$ref": "#/components/schemas/OrdenarPor"
            }
          },
          {
            "name": "direcao",
            "in": "query",
            "schema": {
              "default": "Asc",
              "$ref": "#/components/schemas/Direcao"
            }
          },
          {
            "name": "situacao",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Situacao"
            }
          },
          {
            "name": "prioridade",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Prioridade"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaDtoOfTarefaResumoDto"
                }
              }
            }
          },
