      "get": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Obtém os detalhes de uma tarefa",
        "operationId": "ObterTarefa",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
