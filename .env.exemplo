# =====================================================================
# Roteiro 8 — TODAS as variáveis que o Portal de Tarefas precisa fora do ambiente de desenvolvimento.
# Este arquivo vai para o Git: tem os NOMES e exemplos SEM segredo.
# Para usar: copie para ".env" (que NÃO vai para o Git) e ajuste os valores.
# Em desenvolvimento nada disso é preciso: a conexão vem dos User Secrets.
# O "__" (dois sublinhados) equivale ao ":" do appsettings.json (Externo__BaseUrl = Externo:BaseUrl).
# =====================================================================

# Ambiente: Development, Production... (decide qual appsettings.<Ambiente>.json é lido)
ASPNETCORE_ENVIRONMENT=Production

# OBRIGATÓRIA — conexão com o banco SQLite (dentro do contêiner, na pasta /app/data)
ConnectionStrings__PortalTarefasDb=Data Source=/app/data/portaltarefas.db

# OBRIGATÓRIA — endereço do serviço externo (no contêiner, a própria API na porta 8080)
Externo__BaseUrl=http://localhost:8080/

# Opcional — true: a aplicação cria/atualiza o banco ao iniciar (padrão: false)
Banco__AplicarMigrations=true